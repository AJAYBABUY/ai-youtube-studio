# ==========================================
# AI YOUTUBE STUDIO - ENVIRONMENT CONFIGURATION
# ==========================================

# Core Application Settings
APP_NAME="AI YouTube Studio"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173

# Security & Encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Google OAuth 2.0 Credentials (For YouTube Data API v3)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AI Provider Credentials
# Gemini API Key (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=

# Optional AI Providers (Leave empty to use 100% Free Default Engines)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=

# Free-Tier & Cost Guardrails
PREFER_FREE_TIERS=true
DAILY_SPEND_LIMIT_USD=0.00
MONTHLY_SPEND_LIMIT_USD=0.00
AUTO_PAUSE_ON_LIMIT=true

# Storage and Media Paths
MEDIA_DATA_DIR=data/channels
DATABASE_URL=sqlite:///./data/ai_youtube_studio.db

# FFmpeg Executable (Leave as 'ffmpeg' if in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

